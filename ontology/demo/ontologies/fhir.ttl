fhir:MedicationRequest a owl:Class ;
    rdfs:label "Medication Request" ;
    rdfs:subClassOf schema:Thing .
fhir:Procedure a owl:Class ;
    rdfs:label "Procedure" ;
    rdfs:subClassOf schema:Thing .
fhir:Claim a owl:Class ;
    rdfs:label "Claim" ;
    rdfs:subClassOf schema:Thing .

