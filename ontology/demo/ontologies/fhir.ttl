@prefix fhir: <http://example.com/ont/fhir/> .

<http://example.com/ont/fhir/> a owl:Ontology ; rdfs:label "FHIR source-system ontology" .

# --- Classes ---
fhir:Patient a owl:Class ;
    rdfs:label "Patient" ;
    rdfs:subClassOf schema:Person .
fhir:Practitioner a owl:Class ;
