flowchart LR
    classDef t1 fill:#5C9F69,stroke:#3F6E48,color:#FFFFFF
    classDef t2 fill:#29B5E8,stroke:#1B7DA8,color:#FFFFFF
    classDef t3 fill:#F2A93B,stroke:#B07724,color:#1A1A1A
    classDef t4 fill:#7C4A82,stroke:#532F58,color:#FFFFFF

    subgraph T0 ["TIER 0 · Spike<br/>up to 10⁴ nodes, 10⁵ edges"]
        direction TB
        T0A["Plain tables<br/>no cluster keys yet"]:::t1
        T0B["Recursive CTEs<br/>(no tuning needed)"]:::t1
        T0C["Streamlit + dbt project<br/>+ Cortex Analyst day-one"]:::t1
    end

    subgraph T1 ["TIER 1 · Production v1<br/>10⁵ nodes, 10⁶–10⁷ edges"]
        direction TB
        T1A["Cluster keys on edge,<br/>statement, taxonomy_node"]:::t2
        T1B["Dynamic Tables for<br/>node + edge projections"]:::t2
        T1C["Cortex Search service<br/>over labels + literals"]:::t2
        T1D["dbt schema tests<br/>= SHACL minCount/maxCount"]:::t2
        T1E["DMFs for the<br/>cross-cutting constraints"]:::t2
    end

    subgraph T2 ["TIER 2 · Scale<br/>10⁶–10⁷ nodes, 10⁸–10⁹ edges"]
        direction TB
        T2A["search_optimization service<br/>on statement (subject_uid, object_uid)"]:::t3
        T2B["Hybrid Tables (Unistore)<br/>for individual + hot edges"]:::t3
        T2C["Iceberg for partner / external<br/>federation (read-in-place)"]:::t3
        T2D["Right-sized virtual compute<br/>(SEARCH_WH, AGENT_WH, ANALYTICS_WH)"]:::t3
        T2E["Query Acceleration Service<br/>on the heaviest patterns"]:::t3
    end

    subgraph T3 ["TIER 3 · Billion-edge graph algorithms"]
        direction TB
        T3A["Snowpark Container Services<br/>+ NetworkX / GraphFrames /<br/>cuGraph (GPU)"]:::t4
        T3B["Materialize subgraph on demand<br/>via Snowpark DataFrame<br/>filter on edge"]:::t4
        T3C["Write algorithm output back<br/>as a STATEMENT batch<br/>(PageRank → node.centrality)"]:::t4
    end

    T0 --> T1 --> T2 --> T3
