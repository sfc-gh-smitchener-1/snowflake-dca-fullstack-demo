# Snowflake DCA Demo - Git Ignore

# Generated Data - ignore all data files and subdirectories
data/
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Secrets (never commit)
*.env
.env.*
credentials.json
secrets.yaml
*.pem
*.key

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Personal/internal docs (not for repo)
docs/ENTERPRISE_AI_ARCHITECTURE_PLAYBOOK.md
docs/chat_notes_*.md

# Personal working notes (never commit)
notes for steve/

# Customer / internal reports (never commit)
reports/

# Customer-confidential engagement material (never commit)
# NOTE: customer-demos is a submodule; the effective ignore lives in
# customer-demos/.gitignore. Listed here for documentation.
customer-demos/genentech/

# Blog drafts (internal, not for repo)
blog/
