# Snowflake DCA Demo - Git Ignore

# Generated Data
data/*.csv
data/*.json
data/*.parquet
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Secrets (never commit)
*.env
.env.*
credentials.json
secrets.yaml
*.pem
*.key

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/
